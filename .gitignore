# ==============================================================================
# Node.js & Next.js (Frontend)
# ==============================================================================
# Dependencies
frontend/node_modules/
node_modules/
.pnp
.pnp.js

# Next.js build and cache
frontend/.next/
.next/
frontend/out/
out/
.vercel

# Next.js telemetry and logs
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
# Terraform (Infrastructure as Code)
# ==============================================================================
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (contain sensitive deployment values)
*.tfvars
*.tfvars.json

# Ignore override files as they are usually user-specific
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files for CLI overrides
!example_override.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc

# ==============================================================================
# Docker & Containers
# ==============================================================================
.dockerignore
